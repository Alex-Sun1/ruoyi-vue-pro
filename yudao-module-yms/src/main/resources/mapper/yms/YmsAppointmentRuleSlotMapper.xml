<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.yms.dal.mysql.YmsAppointmentRuleSlotMapper">

    <select id="selectByRuleId" resultType="cn.iocoder.yudao.module.yms.controller.admin.vo.YmsAppointmentRuleSlotRespVO">
        SELECT s.id, s.rule_id, s.weekday, s.start_time, s.end_time,
               s.slot_minutes, s.capacity, s.enabled
        FROM yms_appointment_rule_slot s
        WHERE s.rule_id = #{ruleId}
        ORDER BY s.weekday ASC, s.start_time ASC
    </select>

    <delete id="deleteByRuleId">
        DELETE FROM yms_appointment_rule_slot WHERE rule_id = #{ruleId}
    </delete>

</mapper>
